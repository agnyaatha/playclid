# Normalise line endings to LF in the repository, whatever the contributor's platform.
* text=auto eol=lf

# Binary files: never touch line endings or show text diffs.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary

# Generated: collapsed in pull request diffs and left out of language stats.
package-lock.json linguist-generated=true -diff
